rules_version = '2';

service cloud.firestore {
	match /databases/{database}/documents {
		function isSignedIn() {
			return request.auth != null;
		}

		function isOwner(uid) {
			return isSignedIn() && request.auth.uid == uid;
		}

		function isAdmin() {
			return isSignedIn()
				&& request.auth.token.email is string
				&& request.auth.token.email.lower()
					in ['tmhinkle@gmail.com', 'thinkle@innovationcharter.org'];
		}

		match /users/{uid} {
			allow read, write: if isOwner(uid);
		}

		match /users/{uid}/{document=**} {
			allow read, write: if isOwner(uid);
		}

		match /puzzles/{puzzleId} {
			allow read: if isSignedIn();
			allow create, update, delete: if isAdmin();
		}

		match /puzzle_submissions/{submissionId} {
			allow create: if isSignedIn()
				&& request.resource.data.status == 'pending'
				&& request.resource.data.submittedBy.uid == request.auth.uid
				&& request.resource.data.canonicalUrl is string
				&& request.resource.data.canonicalUrl.size() > 0
				&& request.resource.data.title is string
				&& request.resource.data.title.size() > 0;

			allow read: if isAdmin()
				|| (isSignedIn() && resource.data.submittedBy.uid == request.auth.uid);

			allow update: if isAdmin()
				|| (isSignedIn()
					&& resource.data.submittedBy.uid == request.auth.uid
					&& request.resource.data.submittedBy.uid == request.auth.uid
					&& request.resource.data.status == resource.data.status);

			allow delete: if isAdmin();
		}

		match /{document=**} {
			allow read, write: if false;
		}
	}
}
